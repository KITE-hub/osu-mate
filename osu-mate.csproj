<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OsuMate</RootNamespace>
    <AssemblyName>osu-mate</AssemblyName>
    <AssemblyTitle>osu mate</AssemblyTitle>
    <Product>osu mate</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Resources\Icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Material.Icons.WPF" Version="3.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
		<PackageReference Include="ppy.osu.Game" Version="2026.702.1" />
		<PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.702.1" />
		<PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.702.1" />
		<PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.702.1" />
		<PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.702.1" />
		<PackageReference Include="OsuMemoryDataProvider" Version="0.12.2" />
		<PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.Lame" Version="2.1.0" />
		<PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
		<PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="binaries\soundstretch.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- 同梱フォント（Oxanium / Roboto、いずれもOFL 1.1）とアプリアイコンをWPFの埋め込みリソースとして追加。
	     pack://application:,,,/Resources/... で参照するため Build Action は Resource にする必要がある。 -->
	<ItemGroup>
		<Resource Include="Resources\Fonts\Oxanium\Oxanium-Regular.ttf" />
		<Resource Include="Resources\Fonts\Oxanium\Oxanium-SemiBold.ttf" />
		<Resource Include="Resources\Fonts\Oxanium\Oxanium-Bold.ttf" />
		<Resource Include="Resources\Fonts\Roboto\Roboto-Regular.ttf" />
		<Resource Include="Resources\Fonts\Roboto\Roboto-SemiBold.ttf" />
		<Resource Include="Resources\Fonts\Roboto\Roboto-Bold.ttf" />
		<Resource Include="Resources\Icons\icon.ico" />
	</ItemGroup>

	<!-- OFLライセンス条文。埋め込みリソースとしてexeに含める（コンパイル物として同梱）だけでなく、
	     再配布物として目視・確認しやすいよう出力フォルダにもそのままコピーしておく。 -->
	<ItemGroup>
		<None Include="Resources\Fonts\Oxanium\OFL.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\Fonts\Roboto\OFL.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- OxyPlot（OxyPlot.Wpf）はフォントを常にベースURIなしの単一文字列（new FontFamily(string)）で
	     解決するため、pack://application:,,, の埋め込みリソースを参照できない
	     （WPFがこの経路で許可する絶対URIスキームは file: のみのため）。
	     そのため Regular ウェイトの ttf 実体を出力フォルダにもコピーしておき、
	     Utils/AppFonts.ResolveFontFamilyString がそのファイルを指す file: URI を組み立てて渡す。 -->
	<ItemGroup>
		<None Include="Resources\Fonts\Oxanium\Oxanium-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\Fonts\Roboto\Roboto-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

<ItemGroup>
  <Compile Remove="test/**/*.cs" />
  <None Remove="test/**/*" />
</ItemGroup>
</Project>
