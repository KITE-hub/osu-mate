<UserControl
  x:Class="OsuMate.Views.Controls.PlayStatsChartView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:oxy="http://oxyplot.org/wpf"
>
  <Border
    Background="{DynamicResource SurfaceLevel0Brush}"
    BorderBrush="{DynamicResource SeparatorBrush}"
    BorderThickness="1,0,0,1"
  >
    <StackPanel>
      <oxy:PlotView
        Model="{Binding StarRatingPlotModel}"
        Background="Transparent"
        Height="110"
        Margin="0,5,0,0"
      />
      <oxy:PlotView
        Model="{Binding PpPlotModel}"
        Background="Transparent"
        Height="110"
        Margin="0"
      />
      <oxy:PlotView
        Model="{Binding AccuracyPlotModel}"
        Background="Transparent"
        Height="110"
        Margin="0"
      />
    </StackPanel>
  </Border>
</UserControl>
