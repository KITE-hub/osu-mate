<UserControl
  x:Class="OsuMate.Views.Controls.MainView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:OsuMate.Views.Controls"
>
  <StackPanel Orientation="Vertical" Margin="10,0,10,0">
    <controls:InfoPanel x:Name="InfoPanel" />
    <controls:StrainGraphPanel x:Name="StrainGraphPanel" Margin="0,0,0,10" />

    <ContentControl
      Style="{StaticResource TextPanelStyle}"
      Margin="0,0,0,10"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
    >
      <StackPanel Orientation="Horizontal">
        <controls:URTimeGraph x:Name="URTimeGraph" />
        <controls:URDistGraph x:Name="URDistGraph" Margin="5,0,0,0" />
      </StackPanel>
    </ContentControl>
  </StackPanel>
</UserControl>
