<UserControl x:Class="OsuMate.Views.Controls.ContributionChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <!--
        ContributionGraphView（月単位カレンダーのヒートマップ）の直下に表示する、
        対象月における日ごとの合計打数（MISS以外のHit数の合計）の推移グラフ。
        DataContext は ContributionChartViewModel。ロジックは一切持たず、
        HitsPlotModel をそのまま PlotView.Model にバインドして描画するだけ。

        Background="Transparent" は必須。PlotModel.Background / PlotAreaBackground を
        Transparent にしても、oxy:PlotView（WPFコントロール自体）の既定背景は白のままで
        別物として塗られてしまうため、Darkテーマ時に真っ白な四角が浮いて見えてしまう
        （PlayStatsChartViewと同じ注意点）。

        PlotView 自身は「中身に応じた自然な高さ」を持たないため、明示的な Height を与えている
        （PlayStatsChartViewの各PlotViewと同じ Height=110 に揃え、隣に並ぶグラフ群との
          サイズ感を統一している）。
    -->
    <Border Background="{DynamicResource SurfaceLevel0Brush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,0,0,1">
        <oxy:PlotView Model="{Binding HitsPlotModel}" Background="Transparent" Height="110" Margin="0,4,0,0"/>
    </Border>
</UserControl>
