<UserControl
  x:Class="OsuMate.Views.Controls.TrainerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:utils="clr-namespace:OsuMate.Utils"
  FontFamily="{DynamicResource AppFont}"
>
  <UserControl.Resources>
    <utils:BindingProxy x:Key="Proxy" Data="{Binding}" />

    <Style
      x:Key="RateTextBoxStyle"
      TargetType="TextBox"
      BasedOn="{StaticResource ThemedTextBoxStyle}"
    >
      <Setter Property="Width" Value="50" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="DiffSliderStyle" TargetType="Slider" BasedOn="{StaticResource SliderStyle}">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="10" />
      <Setter Property="SmallChange" Value="0.1" />
      <Setter Property="LargeChange" Value="1.0" />
      <Setter Property="TickFrequency" Value="0.1" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>

    <Style x:Key="DiffValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="32" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="DisabledOpacityGridStyle" TargetType="Grid">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style
      x:Key="BatchDataGridStyle"
      TargetType="DataGrid"
      BasedOn="{StaticResource DataGridBaseStyle}"
    >
      <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style
      x:Key="BatchCellStyle"
      TargetType="DataGridCell"
      BasedOn="{StaticResource DataGridCellBaseStyle}"
    >
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style
      x:Key="BatchRowStyle"
      TargetType="DataGridRow"
      BasedOn="{StaticResource DataGridRowBaseStyle}"
    />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10,0,10,8">
      <StackPanel Margin="{StaticResource SectionSpacing}">
        <Grid Margin="{StaticResource RowSpacing}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Column="0"
            Grid.Row="0"
            Text="Now Playing"
            Style="{StaticResource TextTitleStyle}"
            Margin="{StaticResource RowSpacing}"
          />
          <TextBlock
            Grid.Column="2"
            Grid.Row="0"
            Text="Original BPM"
            Style="{StaticResource TextTitleStyle}"
            Margin="{StaticResource RowSpacing}"
          />
          <ContentControl
            Grid.Column="0"
            Grid.Row="1"
            Style="{StaticResource TextPanelStyle}"
          >
            <StackPanel>
              <TextBlock
                Text="{Binding BeatmapTitle}"
                FontSize="14"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextBrush}"
              />
              <TextBlock
                Text="{Binding BeatmapArtist}"
                FontSize="11"
                Opacity="0.7"
                TextTrimming="CharacterEllipsis"
                Margin="0,0,0,2"
                Foreground="{DynamicResource TextBrush}"
              />
              <TextBlock
                FontSize="11"
                Opacity="0.6"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextBrush}"
              >
                <Run Text="[" />
                <Run Text="{Binding BeatmapVersion, Mode=OneWay}" />
                <Run Text="]" />
              </TextBlock>
            </StackPanel>
          </ContentControl>
          <ContentControl
            Grid.Column="2"
            Grid.Row="1"
            Style="{StaticResource TextPanelStyle}"
          >
            <StackPanel>
              <TextBlock
                Text="{Binding OriginalBpm}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
              />
              <TextBlock
                Text="{Binding OriginalBpmRange}"
                FontSize="11"
                Opacity="0.7"
                Foreground="{DynamicResource TextBrush}"
              />
            </StackPanel>
          </ContentControl>
        </Grid>
      </StackPanel>

      <StackPanel Margin="{StaticResource SectionSpacing}">
        <Grid Margin="{StaticResource RowSpacing}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            Text="Rate"
            Style="{StaticResource TextTitleStyle}"
            VerticalAlignment="Center"
          />

          <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
          >
            <TextBlock
              Text="Start:"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextBrush}"
            />
            <TextBox
              Text="{Binding BatchStartRate, UpdateSourceTrigger=LostFocus}"
              Style="{StaticResource RateTextBoxStyle}"
              Margin="6,0,16,0"
              KeyDown="RateTextBox_KeyDown"
            />

            <TextBlock
              Text="Step:"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextBrush}"
            />
            <TextBox
              Text="{Binding BatchStep, UpdateSourceTrigger=LostFocus}"
              Style="{StaticResource RateTextBoxStyle}"
              Margin="6,0,16,0"
              KeyDown="RateTextBox_KeyDown"
            />

            <TextBlock
              Text="Count:"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextBrush}"
            />
            <TextBox
              Text="{Binding BatchCount, UpdateSourceTrigger=LostFocus}"
              Style="{StaticResource RateTextBoxStyle}"
              Margin="6,0,0,0"
              KeyDown="RateTextBox_KeyDown"
            />
          </StackPanel>
        </Grid>
      </StackPanel>

      <StackPanel Margin="{StaticResource SectionSpacing}">
        <ToggleButton
          x:Name="BatchPreviewToggle"
          Content="Preview"
          IsChecked="True"
          FontSize="14"
          FontWeight="Bold"
          Style="{StaticResource AccordionHeaderStyle}"
          Margin="{StaticResource RowSpacing}"
        />
        <DataGrid
          ItemsSource="{Binding BatchPreviews}"
          Visibility="{Binding IsChecked, ElementName=BatchPreviewToggle, Converter={StaticResource BoolToVisibilityConverter}}"
          Style="{StaticResource BatchDataGridStyle}"
          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderBaseStyle}"
          CellStyle="{StaticResource BatchCellStyle}"
          RowStyle="{StaticResource BatchRowStyle}"
          MinHeight="80"
          MaxHeight="200"
          Margin="0,0,0,4"
        >
          <DataGrid.Columns>
            <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" Width="1*" />
            <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" Width="2*" />

            <DataGridTextColumn
              Header="AR"
              Binding="{Binding ArText}"
              Width="1*"
              Visibility="{Binding Data.IsArCsEditable, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}"
            />
            <DataGridTextColumn Header="OD" Binding="{Binding OdText}" Width="1*" />
            <DataGridTextColumn Header="HP" Binding="{Binding HpText}" Width="1*" />
            <DataGridTextColumn
              Header="CS"
              Binding="{Binding CsText}"
              Width="1*"
              Visibility="{Binding Data.IsArCsEditable, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}"
            />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

      <StackPanel Margin="{StaticResource SectionSpacing}">
        <TextBlock
          Text="Difficulty"
          Style="{StaticResource TextTitleStyle}"
          Margin="{StaticResource RowSpacing}"
        />

        <ContentControl Style="{StaticResource TextPanelStyle}" Padding="10,6" Margin="{StaticResource RowSpacing}">
          <StackPanel>
            <Grid
              Height="26"
              Margin="0,0,0,6"
              IsEnabled="{Binding IsArCsEditable}"
              Style="{StaticResource DisabledOpacityGridStyle}"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="AR"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextBrush}"
              />
              <Slider
                Grid.Column="1"
                Style="{StaticResource DiffSliderStyle}"
                Value="{Binding ArBase, Mode=TwoWay}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="3"
                Text="{Binding ArBaseText, Mode=OneWay}"
                Style="{StaticResource DiffValueStyle}"
              />
              <CheckBox
                Grid.Column="5"
                IsChecked="{Binding ScaleAR}"
                Style="{StaticResource ToggleSwitchStyle}"
                Content="Scale"
                FontSize="11"
                Foreground="{DynamicResource TextBrush}"
                VerticalAlignment="Center"
              />
            </Grid>

            <Grid Height="26" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="OD"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextBrush}"
              />
              <Slider
                Grid.Column="1"
                Style="{StaticResource DiffSliderStyle}"
                Value="{Binding OdBase, Mode=TwoWay}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="3"
                Text="{Binding OdBaseText, Mode=OneWay}"
                Style="{StaticResource DiffValueStyle}"
              />
              <CheckBox
                Grid.Column="5"
                IsChecked="{Binding ScaleOD}"
                Style="{StaticResource ToggleSwitchStyle}"
                Content="Scale"
                FontSize="11"
                Foreground="{DynamicResource TextBrush}"
                VerticalAlignment="Center"
              />
            </Grid>

            <Grid Height="26" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="HP"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextBrush}"
              />
              <Slider
                Grid.Column="1"
                Style="{StaticResource DiffSliderStyle}"
                Value="{Binding HpBase, Mode=TwoWay}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="3"
                Text="{Binding HpBaseText, Mode=OneWay}"
                Style="{StaticResource DiffValueStyle}"
              />
            </Grid>

            <Grid
              Height="26"
              IsEnabled="{Binding IsArCsEditable}"
              Style="{StaticResource DisabledOpacityGridStyle}"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="CS"
                FontSize="12"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextBrush}"
              />
              <Slider
                Grid.Column="1"
                Style="{StaticResource DiffSliderStyle}"
                Value="{Binding CsBase, Mode=TwoWay}"
                VerticalAlignment="Center"
              />
              <TextBlock
                Grid.Column="3"
                Text="{Binding CsBaseText, Mode=OneWay}"
                Style="{StaticResource DiffValueStyle}"
              />
            </Grid>
          </StackPanel>
        </ContentControl>
      </StackPanel>

      <StackPanel Margin="{StaticResource SectionSpacing}">
        <TextBlock
          Text="Options"
          Style="{StaticResource TextTitleStyle}"
          Margin="{StaticResource RowSpacing}"
        />
        <Grid
          Height="24"
          Margin="{StaticResource RowSpacing}"
          IsEnabled="{Binding IsRandomAvailable}"
          Style="{StaticResource DisabledOpacityGridStyle}"
        >
          <DockPanel ToolTipService.InitialShowDelay="100" ToolTipService.ShowOnDisabled="True">
            <DockPanel.ToolTip>
              <ToolTip>
                <ToolTip.Style>
                  <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                    <Setter Property="Width" Value="200" />
                    <Setter Property="MaxWidth" Value="200" />
                  </Style>
                </ToolTip.Style>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="Random:" />
                  <LineBreak />
                  <Run Text="Support for each mode is as follows." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="osu!standard: Supported. Objects are placed randomly according to the following three conditions:" />
                  <LineBreak />
                  <Run Text="1. Maintain the distance between the end point of the previous object and the start position of the next object." />
                  <LineBreak />
                  <Run Text="2. Place objects so they avoid the edges of the playfield as much as possible." />
                  <LineBreak />
                  <Run Text="3. Place objects so they do not overlap with the preceding object as much as possible." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="osu!taiko: Supported. Randomly changes only the color without altering the placement." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="osu!catch: Not supported (randomization is not applied)." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="osu!mania: Supported. Shuffles the lanes while preserving the pattern." />
                </TextBlock>
              </ToolTip>
            </DockPanel.ToolTip>
            <TextBlock
              Text="Random"
              FontSize="12"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextBrush}"
            />
            <CheckBox
              IsChecked="{Binding IsRandomEnabled}"
              Style="{StaticResource ToggleSwitchStyle}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />
          </DockPanel>
        </Grid>

        <Grid
          Height="24"
          Margin="{StaticResource RowSpacing}"
          IsEnabled="{Binding IsDisableSvAvailable}"
          Style="{StaticResource DisabledOpacityGridStyle}"
        >
          <DockPanel ToolTipService.InitialShowDelay="100" ToolTipService.ShowOnDisabled="True">
            <DockPanel.ToolTip>
              <ToolTip>
                <ToolTip.Style>
                  <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                    <Setter Property="Width" Value="200" />
                    <Setter Property="MaxWidth" Value="200" />
                  </Style>
                </ToolTip.Style>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="Disable SV:" />
                  <LineBreak />
                  <Run Text="It removes all inherited timing points (green lines) for constant 1.0x scroll speed." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="OD: 10 (constant)" />
                  <LineBreak />
                  <Run Text="Kiai and 'Omit first bar line': Off (constant)" />
                  <LineBreak />
                  <Run Text="Volume: 100% (constant)" />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="Support for each mode is as follows." />
                  <LineBreak />
                  <LineBreak />
                  <Run Text="osu!standard: Not supported." />
                  <LineBreak />
                  <Run Text="osu!taiko: Supported." />
                  <LineBreak />
                  <Run Text="osu!catch: Not supported." />
                  <LineBreak />
                  <Run Text="osu!mania: Supported." />
                </TextBlock>
              </ToolTip>
            </DockPanel.ToolTip>
            <TextBlock
              Text="Disable SV"
              FontSize="12"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextBrush}"
            />
            <CheckBox
              IsChecked="{Binding DisableSv}"
              Style="{StaticResource ToggleSwitchStyle}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />
          </DockPanel>
        </Grid>

        <Grid Height="24" Margin="{StaticResource RowSpacing}">
          <TextBlock
            Text="Adjust Pitch with Speed"
            FontSize="12"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextBrush}"
          />
          <CheckBox
            IsChecked="{Binding AdjustPitchWithSpeed}"
            Style="{StaticResource ToggleSwitchStyle}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
          />
        </Grid>
      </StackPanel>

      <Button
        x:Name="GenerateButton"
        Content="Generate"
        Height="36"
        FontSize="14"
        FontWeight="Bold"
        IsEnabled="{Binding CanGenerate}"
        Click="Generate_Click"
        Style="{StaticResource AccentButtonStyle}"
        Margin="0,0,0,18"
      />

      <StackPanel Margin="{StaticResource SectionSpacing}">
        <Grid Margin="{StaticResource RowSpacing}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            Text="Offset Map"
            Style="{StaticResource TextTitleStyle}"
            VerticalAlignment="Center"
          />

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <StackPanel
              Orientation="Horizontal"
              Background="Transparent"
              Margin="0,0,16,0"
              ToolTipService.InitialShowDelay="100"
            >
              <StackPanel.ToolTip>
                <ToolTip>
                  <ToolTip.Style>
                    <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                      <Setter Property="Width" Value="200" />
                      <Setter Property="MaxWidth" Value="200" />
                    </Style>
                  </ToolTip.Style>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="16th max BPM:" />
                    <LineBreak />
                    <Run Text="It decides the note spacing of the map." />
                    <LineBreak />
                    <Run Text="Range: 10 - 1000" />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="If the BPM of a section is between half of this value and this value, notes are placed at 16th intervals." />
                    <LineBreak />
                    <Run Text="Otherwise the interval is doubled or halved until it fits (4th, 8th, 32nd, ...), so the spacing stays about the same in every section." />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="Example (240):" />
                    <LineBreak />
                    <Run Text="120 - 240 BPM: 16th" />
                    <LineBreak />
                    <Run Text="over 240 - 480 BPM: 8th" />
                    <LineBreak />
                    <Run Text="60 - under 120 BPM: 32nd" />
                    <LineBreak />
                  </TextBlock>
                </ToolTip>
              </StackPanel.ToolTip>
              <TextBlock
                Text="16th max BPM:"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextBrush}"
              />
              <TextBox
                Text="{Binding OffsetMapSixteenthMaxBpm, UpdateSourceTrigger=LostFocus}"
                Style="{StaticResource RateTextBoxStyle}"
                Margin="6,0,0,0"
                KeyDown="RateTextBox_KeyDown"
              />
            </StackPanel>

            <StackPanel
              Orientation="Horizontal"
              Background="Transparent"
              ToolTipService.InitialShowDelay="100"
            >
              <StackPanel.ToolTip>
                <ToolTip>
                  <ToolTip.Style>
                    <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                      <Setter Property="Width" Value="200" />
                      <Setter Property="MaxWidth" Value="200" />
                    </Style>
                  </ToolTip.Style>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="Scroll BPM:" />
                    <LineBreak />
                    <Run Text="The scroll speed of the notes, expressed as a BPM. A higher value scrolls faster." />
                    <LineBreak />
                    <Run Text="Range: 10 - 1000" />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="The speed is the same in every section even if the BPM of the map changes (the inherited timing line (green line) multiplier is set for each section)." />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="The multiplier can only be between 0.1x and 10x in osu!. If the BPM of a section is extremely low or high compared to this value, the speed of that section differs from the specified one." />
                    <LineBreak />
                  </TextBlock>
                </ToolTip>
              </StackPanel.ToolTip>
              <TextBlock
                Text="Scroll BPM:"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextBrush}"
              />
              <TextBox
                Text="{Binding OffsetMapScrollBpm, UpdateSourceTrigger=LostFocus}"
                Style="{StaticResource RateTextBoxStyle}"
                Margin="6,0,0,0"
                KeyDown="RateTextBox_KeyDown"
              />
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>

      <Button
        x:Name="GenerateOffsetMapButton"
        Content="Generate offset map"
        Height="36"
        FontSize="14"
        FontWeight="Bold"
        IsEnabled="{Binding CanGenerate}"
        Click="GenerateOffsetMap_Click"
        Style="{StaticResource AccentButtonStyle}"
        Margin="0,0,0,8"
        ToolTipService.InitialShowDelay="100"
        ToolTipService.ShowOnDisabled="True"
      >
        <Button.ToolTip>
          <ToolTip>
            <ToolTip.Style>
              <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                <Setter Property="Width" Value="200" />
                <Setter Property="MaxWidth" Value="200" />
              </Style>
            </ToolTip.Style>
            <TextBlock TextWrapping="Wrap">
              <Run Text="Generate offset map:" />
              <LineBreak />
              <Run Text="It creates a special osu!taiko difficulty of the current original map to check the offset (timing)." />
              <LineBreak />
              <LineBreak />
              <Run Text="How to use: play and check Local offset help and UR bar. If your hits are biased early or late, please adjust the offset by following the Local offset help." />
              <LineBreak />
              <LineBreak />
              <Run Text="Notes: ddkkddkk...(evenly spaced)" />
              <LineBreak />
              <Run Text="OD: 10 (constant)" />
              <LineBreak />
              <Run Text="Scroll speed: Following the Scroll BPM" />
              <LineBreak />
              <Run Text="Kiai and 'Omit first bar line': Off (constant)" />
              <LineBreak />
              <Run Text="Volume: 100% (constant)" />
              <LineBreak />
              <Run Text="It's from the first measure after the preview point to the end of the original map." />
              <LineBreak />
              <Run Text="The original red lines are kept as they are, so the notes follow the timing of the original map." />
            </TextBlock>
          </ToolTip>
        </Button.ToolTip>
      </Button>

      <TextBlock
        Text="{Binding StatusMessage}"
        FontSize="11"
        Opacity="0.7"
        TextWrapping="Wrap"
        HorizontalAlignment="Center"
        Foreground="{DynamicResource TextBrush}"
      />
    </StackPanel>
  </ScrollViewer>
</UserControl>
