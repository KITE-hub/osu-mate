<UserControl
  x:Class="OsuMate.Views.Controls.ContributionGraphView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:OsuMate.Views.Controls"
>
  <UserControl.Resources>
    <Style x:Key="ContributionCellStyle" TargetType="Border">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceLevel2Brush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="1">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="0.30" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="2">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="0.55" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="3">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="0.80" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="4">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Opacity" Value="1.0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlaceholderCellStyle" TargetType="Border">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="WeekdayHeaderStyle" TargetType="TextBlock">
      <Setter Property="Width" Value="24" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style
      x:Key="MonthNavButtonStyle"
      TargetType="Button"
      BasedOn="{StaticResource SettingsButtonStyle}"
    >
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="LegendSwatchStyle" TargetType="Border">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Margin" Value="1.5,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource SurfaceLevel2Brush}" />
    </Style>

    <Style x:Key="LegendTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Border
    Background="{DynamicResource SurfaceLevel0Brush}"
    BorderBrush="{DynamicResource SeparatorBrush}"
    BorderThickness="0"
    Padding="10,8"
  >
    <StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
        <Button
          Style="{StaticResource MonthNavButtonStyle}"
          Command="{Binding PreviousMonthCommand}"
          Visibility="{Binding CanGoToPreviousMonth, Converter={x:Static local:BoolToHiddenConverter.Instance}}"
          ToolTip="Previous month"
        >
          <Polygon
            Points="0,4 6,0 6,8"
            Fill="{DynamicResource TextBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Button>
        <ComboBox
          Style="{StaticResource ThemedComboBox}"
          ItemsSource="{Binding AvailableMonths}"
          SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
          MinWidth="100"
          Margin="6,0"
          FontSize="12"
          FontWeight="SemiBold"
        >
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock
                Text="{Binding Converter={x:Static local:MonthDateOnlyConverter.Instance}}"
                FontSize="11"
              />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button
          Style="{StaticResource MonthNavButtonStyle}"
          Command="{Binding NextMonthCommand}"
          Visibility="{Binding CanGoToNextMonth, Converter={x:Static local:BoolToHiddenConverter.Instance}}"
          ToolTip="Next month"
        >
          <Polygon
            Points="6,4 0,0 0,8"
            Fill="{DynamicResource TextBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          />
        </Button>
      </StackPanel>

      <StackPanel HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <TextBlock Text="Sun" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Mon" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Tue" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Wed" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Thu" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Fri" Style="{StaticResource WeekdayHeaderStyle}" />
          <TextBlock Text="Sat" Style="{StaticResource WeekdayHeaderStyle}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="6" Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border ToolTipService.InitialShowDelay="100">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource ContributionCellStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Border.ToolTip>
                  <ToolTip>
                    <ToolTip.Style>
                      <Style TargetType="ToolTip" BasedOn="{StaticResource TrackerToolTipStyle}">
                        <Setter Property="Content" Value="{Binding TooltipText}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ToolTip.Style>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
        <TextBlock Text="Less" Style="{StaticResource LegendTextStyle}" Margin="0,0,3,0" />
        <Border Style="{StaticResource LegendSwatchStyle}" />
        <Border
          Style="{StaticResource LegendSwatchStyle}"
          Background="{DynamicResource AccentBrush}"
          Opacity="0.30"
        />
        <Border
          Style="{StaticResource LegendSwatchStyle}"
          Background="{DynamicResource AccentBrush}"
          Opacity="0.55"
        />
        <Border
          Style="{StaticResource LegendSwatchStyle}"
          Background="{DynamicResource AccentBrush}"
          Opacity="0.80"
        />
        <Border
          Style="{StaticResource LegendSwatchStyle}"
          Background="{DynamicResource AccentBrush}"
          Opacity="1.0"
        />
        <TextBlock Text="More" Style="{StaticResource LegendTextStyle}" Margin="3,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
