<UserControl
  x:Class="OsuMate.Views.Controls.StrainGraphPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:oxy="http://oxyplot.org/wpf"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ContentControl
    Style="{StaticResource TextPanelStyle}"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
  >
    <StackPanel Orientation="Horizontal">
      <oxy:PlotView Model="{Binding PlotModel}" Background="Transparent" Height="105" Width="265" />
      <StackPanel Orientation="Vertical" Margin="10 0 0 0" Width="80">
        <CheckBox
          Style="{StaticResource CheckBoxStyle}"
          Foreground="{Binding BlueBrush}"
          IsChecked="{Binding RhythmVisible}"
          Content="{Binding RhythmLabel}"
          Checked="CheckChanged"
          Unchecked="CheckChanged"
        />
        <CheckBox
          Style="{StaticResource CheckBoxStyle}"
          Foreground="{Binding GreenBrush}"
          IsChecked="{Binding ReadingVisible}"
          Content="{Binding ReadingLabel}"
          Checked="CheckChanged"
          Unchecked="CheckChanged"
        />
        <CheckBox
          Style="{StaticResource CheckBoxStyle}"
          Foreground="{Binding YellowBrush}"
          IsChecked="{Binding ColourVisible}"
          Content="{Binding ColourLabel}"
          Checked="CheckChanged"
          Unchecked="CheckChanged"
        />
        <CheckBox
          Style="{StaticResource CheckBoxStyle}"
          Foreground="{Binding RedBrush}"
          IsChecked="{Binding Stamina1Visible}"
          Content="{Binding Stamina1Label}"
          Checked="CheckChanged"
          Unchecked="CheckChanged"
        />
        <CheckBox
          Style="{StaticResource CheckBoxStyle}"
          Foreground="{Binding PinkBrush}"
          IsChecked="{Binding Stamina2Visible}"
          Content="{Binding Stamina2Label}"
          Checked="CheckChanged"
          Unchecked="CheckChanged"
        />
      </StackPanel>
    </StackPanel>
  </ContentControl>
</UserControl>
