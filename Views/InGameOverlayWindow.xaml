<Window x:Class="OsuMate.Views.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:OsuMate.Utils"
        Title="osu mate - In-Game Overlay"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <utils:BoolToColumnIndexConverter x:Key="BoolToColumnIndexConverter"/>
            <utils:ShowValueFirstToTextAlignmentConverter x:Key="ShowValueFirstToTextAlignmentConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="BackgroundBorder"
                CornerRadius="8"
                Background="#CC000000"
                Visibility="Collapsed"/>
        <Border x:Name="OuterBorder"
                CornerRadius="8"
                BorderThickness="0"
                BorderBrush="White"
                Padding="4">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="{Binding DataContext.IsShowValueFirst, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToColumnIndexConverter}, ConverterParameter=Label}"
                                       Text="{Binding Label}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="White"
                                       FontFamily="{DynamicResource AppFont}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="{Binding DataContext.IsShowValueFirst, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToColumnIndexConverter}, ConverterParameter=Value}"
                                       Text="{Binding Value}"
                                       TextAlignment="{Binding DataContext.IsShowValueFirst, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ShowValueFirstToTextAlignmentConverter}}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontFamily="{DynamicResource AppFont}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
