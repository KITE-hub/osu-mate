<Window x:Class="OsuMate.Views.URBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:OsuMate.Views.Behaviors"
        Title="osu mate - UR Bar"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MinWidth="40"
        MinHeight="20"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="BackgroundBorder"
                CornerRadius="8"
                Background="#CC000000"
                Visibility="Collapsed"/>
        <Border x:Name="OuterBorder"
                CornerRadius="8"
                BorderThickness="0"
                BorderBrush="White"/>
        <Canvas x:Name="BarsCanvas" Margin="0"/>

        <!-- 横向き用ラベル（0° / 180°） -->
        <TextBlock x:Name="LabelEarlyH" Text="EARLY" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Margin="6,0,0,0"
                   FontSize="10" Foreground="White" Opacity="0.6"/>
        <TextBlock x:Name="LabelLateH" Text="LATE" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="0,0,6,0"
                   FontSize="10" Foreground="White" Opacity="0.6"/>

        <!-- 縦向き用ラベル（90° / 270°） -->
        <TextBlock x:Name="LabelEarlyV" Text="EARLY" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,4,0,0"
                   FontSize="10" Foreground="White" Opacity="0.6"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="LabelLateV" Text="LATE" HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" Margin="0,0,0,4"
                   FontSize="10" Foreground="White" Opacity="0.6"
                   Visibility="Collapsed"/>

        <!-- リサイズハンドル（Win32ネイティブリサイズの実処理はNativeResizeBehaviorに委譲） -->
        <Border x:Name="ResizeRight" Width="6" HorizontalAlignment="Right"
                Background="Transparent" Cursor="SizeWE" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="Right"/>
        <Border x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left"
                Background="Transparent" Cursor="SizeWE" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="Left"/>
        <Border x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNS" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="Bottom"/>
        <Border x:Name="ResizeTop" Height="6" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNS" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="Top"/>
        <Border x:Name="ResizeCorner" Width="10" Height="10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNWSE" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="BottomRight"/>
        <Border x:Name="ResizeCornerTopLeft" Width="10" Height="10"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNWSE" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="TopLeft"/>
        <Border x:Name="ResizeCornerTopRight" Width="10" Height="10"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNESW" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="TopRight"/>
        <Border x:Name="ResizeCornerBottomLeft" Width="10" Height="10"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNESW" Visibility="Collapsed"
                behaviors:NativeResizeBehavior.Direction="BottomLeft"/>
    </Grid>
</Window>
